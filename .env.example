# Copy to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO
PORT=8000

# --- Access: comma-separated codes you hand out (e.g. one per recruiter).
# Sent by clients in the X-Access-Code header (or "Authorization: Bearer <code>"
# for MCP clients). Empty = every request is rejected (fails closed). ---
ACCESS_CODES=
# Hard cap on claim assessments per UTC day -- protects prepaid OpenAI credit.
MAX_RUNS_PER_DAY=50

# --- Database: MongoDB Atlas M0 (free). Vector + full-text search need Atlas. ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_DB_NAME=claims_assistant_v2

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval ---
RETRIEVAL_MODE=hybrid   # hybrid | vector
RAG_TOP_K=4

# --- Optional: Langfuse tracing (leave empty to disable) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
